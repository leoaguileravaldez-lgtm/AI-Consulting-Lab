{
  "model_id": "AILAB-L14-FORMAL-CLEAN-DESIGN",
  "version": "1.0.1",
  "normative": true,
  "manual_semantic_exceptions": false,
  "derivation_rules": {
    "node": "one node class for every event_type, closure_type, and projection_type",
    "edge": "one directed edge for each transition_rule.sources member to transition_rule.destination",
    "rank": "rank=(attempt_epoch,phase,event_ordinal); SAME sources have lower phase; PREVIOUS_ATTEMPT sources have lower attempt_epoch",
    "schema": "identifier types, primitives, type declarations, authority classes and transition rules project without addition or omission",
    "documentation": "may explain projected facts but may not introduce a type, edge, authority, cardinality, guard, or invariant"
  },
  "formal_primitives": [
    {"id":"P1","name":"AuthorityWitness","authoritative":true,"purpose":"attest acceptance by a separately authorized authority","cannot":["witness itself","derive authority from subject","replace closure"]},
    {"id":"P2","name":"TypedEvent","authoritative":"only with P1","purpose":"immutable phase-specific fact","identity":"type+action+domain+attempt_epoch+ordinal+version"},
    {"id":"P3","name":"TransitionRule","authoritative":true,"purpose":"sole declaration of valid source-to-destination construction","identity":"rule_id+catalog_version"},
    {"id":"P4","name":"ClosureWitness","authoritative":true,"purpose":"externally close an exact accepted-event set","cannot":["add events","project state","certify itself"]},
    {"id":"P5","name":"StateProjection","authoritative":"derived under P4","purpose":"deterministic state from exact closed history and rule catalog","cannot":["close inputs","assert currentness","create authority"]}
  ],
  "identifier_types": [
    {"id":"CanonicalBusinessActionId","basis":"hash(client_entity,engagement,request_family,canonical_target,canonical_action,purpose,scope,jurisdiction,confidentiality,stable_business_key)","excludes":["request_transport_id","execution_attempt_id","retry_id","recovery_id","permit_id","policy_version","human_approval_version","timestamp","worker","route","adapter"]},
    {"id":"AuthorityDomainId","basis":"hash(CanonicalBusinessActionId,AuthorityMandateId)"},
    {"id":"ExecutionAttemptId","basis":"attempt-specific nonce within AuthorityDomainId"},
    {"id":"IdentityDomainId","basis":"resolved Layer13 actor/deputy/executor chain"},
    {"id":"PolicyAuthorityId","basis":"policy authority and lineage"},
    {"id":"HumanPrincipalAuthorityId","basis":"exact Human Principal authority lineage"},
    {"id":"ContextAuthorityId","basis":"authoritative PIP source set"},
    {"id":"MediationDomainId","basis":"canonical route+target+action"},
    {"id":"TargetGenerationId","basis":"canonical target+generation"},
    {"id":"JournalHistoryId","basis":"AuthorityDomainId"},
    {"id":"ClosureWitnessId","basis":"JournalHistoryId+attempt_epoch+closure_stage+exact_event_set_hash"},
    {"id":"ProjectionId","basis":"ClosureWitnessId+transition_catalog_version+projection_algorithm_version"},
    {"id":"EffectSlotId","basis":"hash(CanonicalBusinessActionId,effect_kind)","aliases":"UniquenessDomainId"}
  ],
  "authority_classes": [
    {"id":"L13_AUTHORITY","source":"exact Layer13 Access Request+Authorization Decision+Access Decision+reconciliation","sod":"Layer13-certified","may":"authorize bounded Layer14 mandate","may_not":"supply journal, closure, uniqueness, PEP, target, or effect guarantees"},
    {"id":"MANDATE_ISSUER","source":"L13_AUTHORITY plus required Human Principal authority","sod":"issuer differs from subject and runtime operators"},
    {"id":"EVENT_ACCEPTOR","source":"AuthorityMandate","sod":"cannot be closure authority for same domain"},
    {"id":"CLOSURE_AUTHORITY","source":"AuthorityMandate","sod":"must differ from EVENT_ACCEPTOR and projection subject"},
    {"id":"POLICY_AUTHORITY","source":"AuthorityMandate bounded policy administration authority"},
    {"id":"HUMAN_PRINCIPAL","source":"exact Layer13 Human Principal reference","sod":"non-proxyable"},
    {"id":"EXTERNAL_APPROVER","source":"verified qualified external source","sod":"never internal authority by implication"},
    {"id":"PIP_AUTHORITY","source":"mandate-listed authoritative context sources"},
    {"id":"PEP_TOPOLOGY_AUTHORITY","source":"mandate-listed route mediation authority"},
    {"id":"REVOCATION_AUTHORITY","source":"authority governing revoked ancestor"},
    {"id":"TARGET_AUTHORITY","source":"authoritative target-state owner"},
    {"id":"PERMIT_ISSUER","source":"AuthorityMandate bounded permit family"}
  ],
  "authority_unions": [
    {"id":"HUMAN_PRINCIPAL_OR_TYPED_NOT_REQUIRED","variants":["HUMAN_PRINCIPAL","MANDATE_ISSUER"],"rule":"MANDATE_ISSUER variant must certify policy-defined non-applicability; missing never means not required"},
    {"id":"EXTERNAL_APPROVER_OR_TYPED_NOT_REQUIRED","variants":["EXTERNAL_APPROVER","MANDATE_ISSUER"],"rule":"MANDATE_ISSUER variant must certify policy-defined non-applicability; internal authority cannot synthesize approval"}
  ],
  "rank_model": {
    "attempt_epoch":{"initial":1,"retry_recovery":"previous+1","foundation":0},
    "phase_ordinals":{"AUTHORITY_INGEST":10,"CANONICALIZATION":11,"BUSINESS_IDENTITY":12,"AUTHORITY_MANDATE":13,"CONTEXT":20,"BREAK_GLASS_TRANSFORMATION":21,"ATTEMPT":30,"AUTHORITY_CLOSURE":40,"AUTHORITY_PROJECTION":41,"CLAIM":50,"CLAIM_CLOSURE":60,"CLAIM_PROJECTION":61,"PERMIT":70,"MEDIATION":80,"MEDIATION_CLOSURE":90,"MEDIATION_PROJECTION":91,"CONSUMPTION":100,"CONSUMPTION_CLOSURE":110,"CONSUMPTION_PROJECTION":111,"TARGET_PRECONDITION":120,"PRE_EFFECT_REVALIDATION":121,"EFFECT_AUTHORIZATION":130,"EFFECT_CLOSURE":140,"EFFECT_PROJECTION":141,"EFFECT_BARRIER":150,"EFFECT":160,"OUTCOME":170,"AUDIT":180,"RETRY_DECISION":190},
    "rule":"every source rank must be strictly less than destination rank; PREVIOUS_ATTEMPT compares attempt_epoch before phase",
    "same_rank_authoritative_edges_allowed":false
  },
